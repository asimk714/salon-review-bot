# ── Supabase (frontend client) ──────────────────────────────────────────────
# Obtained from Supabase dashboard → Project Settings → API
# These are safe to expose in the browser (publishable, not secret).
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here

# ── Supabase project identifier (used by some integrations) ─────────────────
VITE_SUPABASE_PROJECT_ID=your-project-id

# ── Lovable AI gateway API key ──────────────────────────────────────────────
# This is a SERVER-SIDE secret. Set it in Supabase Dashboard →
# Edge Functions → Environment Variables (not in the frontend .env).
# The edge function reads it via Deno.env.get("LOVABLE_API_KEY").
# Leave this line commented or use a placeholder — never commit a real value.
# LOVABLE_API_KEY=your-lovable-api-key
